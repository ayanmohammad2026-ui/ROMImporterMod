{}#include <Geode/Geode.hpp>
#include <Geode/ui/Popup.hpp>
#include <fstream>

using namespace geode::prelude;

// 1. Create a custom popup menu for your ROM Importer
class ROMImporterPopup : public Popup<> {
protected:
    bool setup() override {
        this->setTitle("ROM to GD Level Importer");

        // Create a button to trigger the import process
        auto importButton = CCMenuItemSpriteExtra::create(
            ButtonSprite::create("Select ROM"),
            this,
            menu_selector(ROMImporterPopup::onImportClicked)
        );
        importButton->setPosition({0, 0});
        
        this->m_buttonMenu->addChild(importButton);
        return true;
    }

    void onImportClicked(CCObject* sender) {
        FLAlertLayer::create("Importer", "Scanning for ROM files...", "OK")->show();
        
        // Call your file parsing and object generation function here
        this->parseAndGenerateLevel("example_path.rom");
    }

    void parseAndGenerateLevel(const std::string& filepath) {
        // Example logic: Reading binary file data using standard C++ streams
        std::ifstream file(filepath, std::ios::binary);
        if (!file.is_open()) {
            log::error("Failed to open ROM file!");
            return;
        }

        // Read bytes
        std::vector<char> buffer((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
        file.close();

        int gridX = 0;
        int gridY = 0;

        // Ensure we are inside a level editor context
        if (auto editor = LevelEditorLayer::get()) {
            for (char byte : buffer) {
                // If byte meets condition, spawn a block object into the editor
                if (byte > 128) {
                    // Create a GameObject (ID 1 is a standard block)
                    int objID = 1;
                    CCPoint pos = { static_cast<float>(gridX * 30), static_cast<float>(gridY * 30) };
                    
                    // GD function to create objects in the active editor
                    GameObject* obj = editor->createObject(objID, pos);
                    if (obj) {
                        // Optional: configure object properties
                    }
                }

                gridX++;
                if (gridX > 20) {
                    gridX = 0;
                    gridY++;
                }
            }
            FLAlertLayer::create("Success!", "ROM successfully converted to level objects!", "OK")->show();
        } else {
            FLAlertLayer::create("Error", "You must be inside the Level Editor to import a ROM!", "OK")->show();
        }
    }
};

// 2. Add an entry point to open your mod's menu from the pause menu or editor menu
#include <Geode/modify/PauseLayer.log.hpp> // Or LevelEditorLayer
class $modify(MyPauseLayer, PauseLayer) {
    void customSetup() {
        PauseLayer::customSetup();

        // Add an extra button to the pause menu to open your ROM importer
        auto menu = this->getChildByID("center-menu");
        if (menu) {
            auto romBtn = CCMenuItemSpriteExtra::create(
                ButtonSprite::create("ROM Importer"),
                this,
                menu_selector(MyPauseLayer::onOpenROMImporter)
            );
            romBtn->setID("rom-importer-btn"_spr);
            menu->addChild(romBtn);
            menu->updateLayout();
        }
    }

    void onOpenROMImporter(CCObject*) {
        ROMImporterPopup::create()->show();
    }
};
